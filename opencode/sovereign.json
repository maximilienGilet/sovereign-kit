{
  "$schema": "https://opencode.ai/config.json",
  "model": "sovereign-qwen/qwen3.8-27b-nvfp4",
  "enabled_providers": [
    "sovereign-qwen"
  ],
  "provider": {
    "sovereign-qwen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Private Qwen via local tunnel",
      "options": {
        "baseURL": "http://127.0.0.1:30000/v1",
        "apiKey": "{env:QWEN_LOCAL_API_KEY}"
      },
      "models": {
        "qwen3.8-27b-nvfp4": {
          "name": "Qwen 3.8 27B NVFP4 (private)",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      }
    }
  }
}
